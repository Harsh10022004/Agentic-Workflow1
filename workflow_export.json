    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst fullText = items[0].json.text || \"\";\nconst chunkSize = 500;\nconst startIndex = ($execution.resumeData?.chunkIndex || 0) * chunkSize;\nconst chunk = fullText.substring(startIndex, startIndex + chunkSize);\nreturn [{ json: { ...items[0].json, textChunk: chunk, chunkIndex: startIndex / chunkSize } }];"
      },
      "id": "9899b136-62a3-4700-80f4-b51e175d0d42",
      "name": "Create Text Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        320
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract all mathematical concepts, algorithms, and technical terms from this text chunk:\n\n{{ $json.textChunk }}\n\nReturn a JSON array of algorithms_found.\n\nYou MUST return a JSON object. The JSON must contain a key named exactly \"algorithms_found\" which holds an array of strings. Example: {\"algorithms_found\": [\"Proof of Work\", \"SHA-256\"]}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a technical information extractor. Extract mathematical concepts, algorithms, and technical terms from research papers. Return only the structured JSON output with an array of algorithms_found."
        }
      },
      "id": "0a4c29b7-f897-4f7d-b62b-70298b0f6181",
      "name": "Information Extractor AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1360,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet output = items[0].json.output;\n\nif (typeof output === 'string') {\n    let cleanText = output.replace(/```json/gi, '').replace(/```/g, '').trim();\n    output = JSON.parse(cleanText);\n}\n\n// Bouncer (Guardrail) ki checking\nif (!output || !Array.isArray(output.algorithms_found) || output.algorithms_found.length === 0) {\n    throw new Error(\"Invalid format - retry extraction\");\n}\n\nconst cleanList = output.algorithms_found.filter(item => typeof item === \"string\" && item.trim().length > 0);\n\nreturn [{ json: { ...items[0].json, cleanAlgorithms: cleanList } }];"
      },
      "id": "548eda48-cf8e-4cc4-a217-06e518063583",
      "name": "Formatting Guardrail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
        320
      ]
    },
    {
      "parameters": {
