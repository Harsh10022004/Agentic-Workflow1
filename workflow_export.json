    {
      "parameters": {
        "jsCode": "const text = $input.first().json.output || \"\";\nconst paragraphs = text.split('\\n');\n\nlet chunks = [];\nlet currentChunk = \"\";\n\nfor (let p of paragraphs) {\n  if (!p.trim()) continue; // Khali lines ko bypass karo\n  \n  // Safe limit mein paragraphs ko jodte jao\n  if ((currentChunk.length + p.length) < 1900) {\n    currentChunk += p + '\\n\\n';\n  } else {\n    if (currentChunk.trim()) chunks.push(currentChunk.trim());\n    currentChunk = p + '\\n\\n';\n  }\n}\nif (currentChunk.trim()) chunks.push(currentChunk.trim());\n\n// Complex array ke bajaye 5 simple variables bhejo (taaki Notion UI confuse na ho)\nreturn [{ \n  json: { \n    chunk1: chunks[0] || \" \",\n    chunk2: chunks[1] || \" \",\n    chunk3: chunks[2] || \" \",\n    chunk4: chunks[3] || \" \",\n    chunk5: chunks[4] || \" \"\n  } \n}];"
      },
