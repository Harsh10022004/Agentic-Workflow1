    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate the technical soundness and completeness of this extracted topic list from a research paper:\n\n{{ $json.masterTopicList }}\n\nProvide a safety_score (1-100) and detailed flaws analysis.\n\nAnalyze the text and provide a safety score. Return ONLY the raw number. Do not write any extra words, do not use JSON, do not use markdown or backticks. Just output the digits. Example: 85",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a research paper critic. Evaluate extracted topics for completeness, accuracy, and technical soundness. Score 80+ means the extraction is reliable. Below 80 requires human review. Return structured JSON with safety_score (number) and flaws (string)."
        }
      },
